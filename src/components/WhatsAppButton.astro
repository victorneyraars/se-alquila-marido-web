---
interface Props {
  message?: string;
  label?: string;
  variant?: 'primary' | 'secondary';
}
const {
  message = 'Hola! Quiero consultar sobre servicios de mecánica.',
  label = 'Contactar por WhatsApp',
  variant = 'secondary',
} = Astro.props;
const phone = '56912345679';
const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
const cls = variant === 'primary' ? 'btn-primary' : 'btn-secondary';
---

<a href={url} target="_blank" rel="noopener noreferrer" class={cls}>
  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
    <path d="M17.6 6.3a7.9 7.9 0 0 0-13.4 5.7 7.8 7.8 0 0 0 1.1 4L4 20l4.1-1.1a7.9 7.9 0 0 0 3.8 1 7.9 7.9 0 0 0 5.7-13.6zm-5.7 12.2a6.5 6.5 0 0 1-3.3-.9l-.2-.1-2.4.6.7-2.3-.2-.2a6.5 6.5 0 1 1 5.4 2.9zm3.6-4.9c-.2-.1-1.2-.6-1.4-.7s-.3-.1-.4.1l-.6.7c-.1.1-.2.2-.4.1a5.3 5.3 0 0 1-2.6-2.3c-.2-.3.2-.3.5-.9.1-.2 0-.3 0-.4l-.6-1.4c-.1-.3-.3-.3-.4-.3h-.4a.8.8 0 0 0-.5.2 2.2 2.2 0 0 0-.7 1.7 3.8 3.8 0 0 0 .8 2 8.8 8.8 0 0 0 3.4 3 3.7 3.7 0 0 0 2.3.5 2 2 0 0 0 1.3-.9 1.6 1.6 0 0 0 .1-.9c0-.1-.2-.2-.4-.3z"/>
  </svg>
  <span>{label}</span>
</a>
