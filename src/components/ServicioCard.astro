---
import { formatearPrecio, type Servicio } from '../config/api';
interface Props { servicio: Servicio; }
const { servicio } = Astro.props;
const precio = servicio.precio_desde_clp ? `Desde ${formatearPrecio(servicio.precio_desde_clp)}` : 'Consultar';
---
<div class="card">
  <div class="flex items-start justify-between gap-3 mb-2">
    <h3 class="font-bold text-sam-light text-base leading-tight">{servicio.nombre}</h3>
    {servicio.destacado && (
      <span class="text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-sam-accent/20 text-sam-accent border border-sam-accent/40 shrink-0">Destacado</span>
    )}
  </div>
  {servicio.descripcion && <p class="text-xs text-sam-light/60 mb-3">{servicio.descripcion}</p>}
  <div class="flex items-center justify-between pt-3 border-t border-sam-primary/10">
    <span class="text-sm font-bold text-sam-accent">{precio}</span>
    {servicio.duracion_estimada_min && (
      <span class="text-[11px] text-sam-light/50">⏱ {servicio.duracion_estimada_min} min</span>
    )}
  </div>
</div>
