---
interface Props {
  servicios?: Array<{ id: string; nombre: string; precio_desde_clp: number | null }>;
}
const { servicios = [] } = Astro.props;
---
<div id="reserva-section" class="scroll-mt-24 bg-white rounded-2xl shadow-lg p-6 md:p-8 mt-12 max-w-2xl mx-auto">
  <h2 class="text-2xl md:text-3xl font-bold text-sam-dark mb-2 text-center">
    Reservá tu turno
  </h2>
  <p class="text-center text-gray-600 mb-6">
    Coordinamos día, hora y presupuesto por email. Sin cargo por reserva.
  </p>

  <form id="reserva-form" class="space-y-4">
    <div id="form-initial">
      <label class="block text-sm font-medium text-gray-700 mb-1">
        ¿Qué necesitás?
      </label>
      <select id="servicio" required class="w-full p-3 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-sam-accent bg-white">
        <option value="">Elegí un servicio...</option>
        <option value="mantenimiento">Mantenimiento preventivo</option>
        <option value="frenos">Frenos</option>
        <option value="motor">Reparación de motor</option>
        <option value="diagnostico">Diagnóstico computarizado</option>
        <option value="otro">Otro (especificar)</option>
      </select>

      <label class="block text-sm font-medium text-gray-700 mb-1 mt-4">
        ¿Cuándo te viene bien?
      </label>
      <input
        type="datetime-local"
        id="fecha"
        required
        class="w-full p-3 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-sam-accent bg-white"
      />
    </div>

    <div class="grid grid-cols-2 gap-4 mt-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Marca</label>
        <input
          type="text"
          id="marca"
          required
          placeholder="Toyota"
          class="w-full p-3 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-sam-accent bg-white"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Modelo</label>
        <input
          type="text"
          id="modelo"
          required
          placeholder="Corolla"
          class="w-full p-3 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-sam-accent bg-white"
        />
      </div>
    </div>

    <div class="mt-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Año</label>
      <input
        type="number"
        id="anio"
        min="1980"
        max="2030"
        placeholder="2015"
        class="w-full p-3 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-sam-accent bg-white"
      />
    </div>

      <label class="block text-sm font-medium text-gray-700 mb-1 mt-4">
        Contanos brevemente qué pasa (opcional)
      </label>
      <textarea
        id="motivo"
        rows="3"
        placeholder="Hace un ruido raro al frenar..."
        class="w-full p-3 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-sam-accent bg-white"
      ></textarea>
    </div>

    <button
      type="button"
      id="btn-submit"
      class="w-full bg-sam-accent text-white font-semibold py-3 px-6 rounded-lg hover:bg-sam-dark transition-colors mt-6"
    >
      Reservar con Google
    </button>

    <div id="resultado" class="hidden mt-4 p-4 rounded-lg"></div>
  </form>
</div>
<script>
  (function() {
    console.log('[RESERVA] Script cargado');

    async function initForm() {
      var form = document.getElementById('reserva-form');
      var btn = document.getElementById('btn-submit');
      var resultado = document.getElementById('resultado');

      if (!form || !btn || !resultado) {
        console.error('[RESERVA] Faltan elementos');
        return;
      }

      // 1. Chequear si volvimos del redirect de Google
      console.log('[RESERVA] Chequeando redirect result...');
      var firebaseMod = await import('../lib/firebase');
      var idToken = await firebaseMod.getGoogleRedirectResult();

      if (idToken) {
        console.log('[RESERVA] Token del redirect obtenido');
        // Guardamos el token en sessionStorage y ejecutamos el submit
        sessionStorage.setItem('pending_reserva_token', idToken);
        // Disparamos el submit automáticamente
        await submitReserva(idToken);
      }

      // 2. Click handler
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        btn.disabled = true;
        var textoOriginal = btn.textContent;
        btn.textContent = 'Redirigiendo a Google...';

        try {
          // Guardar datos del form en sessionStorage (para recuperarlos al volver)
          sessionStorage.setItem('pending_reserva_data', JSON.stringify({
            marca: document.getElementById('marca').value,
            modelo: document.getElementById('modelo').value,
            anio: document.getElementById('anio').value,
            fecha_inicio: document.getElementById('fecha').value,
            motivo: document.getElementById('motivo').value
          }));

          // Redirigir a Google
          await firebaseMod.signInWithGoogleRedirect();
          // Esta línea no se ejecuta (el navegador redirige)

        } catch (err) {
          console.error('[RESERVA] Error redirect:', err);
          resultado.className = 'mt-4 p-4 rounded-lg bg-red-50 text-red-800';
          resultado.textContent = 'Error: ' + err.message;
          resultado.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = textoOriginal;
        }
      });

      // 3. Función submit (después de volver del redirect)
      async function submitReserva(idToken) {
        var resultado = document.getElementById('resultado');
        var dataStr = sessionStorage.getItem('pending_reserva_data');

        if (!dataStr) {
          console.error('[RESERVA] No hay datos guardados');
          return;
        }

        var data = JSON.parse(dataStr);
        var payload = Object.assign({ id_token: idToken }, data);

        resultado.className = 'mt-4 p-4 rounded-lg bg-blue-50 text-blue-800';
        resultado.textContent = 'Creando reserva...';
        resultado.classList.remove('hidden');

        try {
          var r = await fetch('/api/reservas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          var resData = await r.json();

          if (r.ok && resData.success) {
            resultado.className = 'mt-4 p-4 rounded-lg bg-green-50 text-green-800';
            resultado.innerHTML = '<strong>¡Reserva creada!</strong><br>Te enviamos un email de confirmación.<br><a href="/app" class="text-sam-accent underline">Descargá la app</a> para seguir tu turno.';
            sessionStorage.removeItem('pending_reserva_data');
            sessionStorage.removeItem('pending_reserva_token');
          } else {
            throw new Error(resData.error || 'Error creando reserva');
          }
        } catch (err) {
          console.error('[RESERVA] Error submit:', err);
          resultado.className = 'mt-4 p-4 rounded-lg bg-red-50 text-red-800';
          resultado.textContent = 'Error: ' + err.message;
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initForm);
    } else {
      initForm();
    }
  })();
</script>
