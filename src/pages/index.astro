---
import Layout from '../layouts/Layout.astro';
import ServicioCard from '../components/ServicioCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import {
  fetchPrestadorPorSlug,
  fetchReviewsPrestador,
  type PrestadorDetalle,
  type Review,
} from '../config/api';

export const prerender = false;

const [prestador, reviews] = await Promise.all([
  fetchPrestadorPorSlug('se-alquila-marido'),
  fetchReviewsPrestador('se-alquila-marido'),
]);

const servicios = prestador?.servicios ?? [];
const rating = prestador ? Number(prestador.calificacion_promedio).toFixed(1) : '—';
const totalReviews = prestador?.total_resenas ?? 0;
const aniosExp = prestador?.anios_experiencia ?? 0;
const atiendeEmergencias = prestador?.atiende_emergencias ?? false;

const reservaUrl = 'https://www.baqueanonatales.com/prestadores/se-alquila-marido';
---

<Layout title="Se Alquila Marido — Mecánica automotriz en Puerto Natales">
  <slot name="head" />

  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-sam-primary/10 via-transparent to-transparent pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-sam-primary/10 border border-sam-primary/30 mb-6">
        <span class="w-2 h-2 rounded-full bg-sam-accent animate-pulse"></span>
        <span class="text-xs font-semibold text-sam-accent tracking-wide">Mecánica automotriz · Puerto Natales</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] max-w-3xl">
        El experto que <span class="text-sam-accent">necesitas hoy</span>
      </h1>

      <p class="mt-6 text-base sm:text-lg text-sam-light/70 max-w-2xl leading-relaxed">
        Mecánica automotriz profesional en Puerto Natales. Servicio puerta a puerta, garantía escrita y atención directa por WhatsApp.
      </p>

      {totalReviews > 0 && (
        <div class="mt-6 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-sam-dark/60 border border-sam-primary/20">
          <span class="text-sam-accent font-bold text-sm">{rating} ★</span>
          <span class="text-sam-light/50 text-xs">({totalReviews} reseña{totalReviews === 1 ? '' : 's'})</span>
        </div>
      )}

      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href={reservaUrl} class="btn-primary">Reservar turno</a>
        <WhatsAppButton variant="secondary" label="Consultar por WhatsApp" />
      </div>

      <div class="mt-12 grid grid-cols-3 gap-4 max-w-lg">
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-sam-accent">{servicios.length}</div>
          <div class="text-[11px] uppercase tracking-wider text-sam-light/50 font-semibold mt-1">Servicios</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-sam-accent">{aniosExp}</div>
          <div class="text-[11px] uppercase tracking-wider text-sam-light/50 font-semibold mt-1">Años exp.</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-sam-accent">{atiendeEmergencias ? '24/7' : '—'}</div>
          <div class="text-[11px] uppercase tracking-wider text-sam-light/50 font-semibold mt-1">Emergencias</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICIOS ============ -->
  <section id="servicios" class="py-16 sm:py-20 border-t border-sam-primary/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10">
        <p class="section-title">Servicios</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Lo que puedo hacer por tu auto</h2>
      </div>

      {servicios.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {servicios.map((s) => <ServicioCard servicio={s} />)}
        </div>
      ) : (
        <p class="text-sam-light/60 text-sm">Cargando servicios…</p>
      )}

      <div class="mt-10 card text-center">
        <p class="text-sm text-sam-light/70 mb-4">¿No encontrás lo que buscás?</p>
        <WhatsAppButton variant="primary" label="Escribime y lo vemos" message="Hola! Necesito un servicio que no está en la lista, ¿me podés ayudar?" />
      </div>
    </div>
  </section>

  <!-- ============ POR QUÉ ELEGIRNOS ============ -->
  <section class="py-16 sm:py-20 border-t border-sam-primary/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10">
        <p class="section-title">Por qué elegirnos</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Confianza en cada trabajo</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card">
          <div class="text-3xl mb-3">🔧</div>
          <h3 class="font-bold text-sam-light text-base mb-1">{aniosExp} años de experiencia</h3>
          <p class="text-xs text-sam-light/60">Oficio aprendido y perfeccionado en la ruta.</p>
        </div>
        <div class="card">
          <div class="text-3xl mb-3">🛡️</div>
          <h3 class="font-bold text-sam-light text-base mb-1">Garantía escrita</h3>
          <p class="text-xs text-sam-light/60">Cada trabajo respaldado por escrito.</p>
        </div>
        <div class="card">
          <div class="text-3xl mb-3">⏰</div>
          <h3 class="font-bold text-sam-light text-base mb-1">{atiendeEmergencias ? 'Atención 24/7' : 'Horario extendido'}</h3>
          <p class="text-xs text-sam-light/60">Cuando tu auto falla, no hay horario.</p>
        </div>
        <div class="card">
          <div class="text-3xl mb-3">🚗</div>
          <h3 class="font-bold text-sam-light text-base mb-1">Servicio a domicilio</h3>
          <p class="text-xs text-sam-light/60">Voy donde está tu vehículo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ REVIEWS ============ -->
  {reviews.length > 0 && (
    <section class="py-16 sm:py-20 border-t border-sam-primary/10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="mb-10">
          <p class="section-title">Reseñas</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Lo que dicen mis clientes</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {reviews.map((r) => <ReviewCard review={r} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ============ CTA FINAL ============ -->
  <section id="contacto" class="py-16 sm:py-24 border-t border-sam-primary/10">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">¿Listo para empezar?</h2>
      <p class="text-sam-light/70 mb-8 max-w-xl mx-auto">
        Reservá tu turno online o escribime directo por WhatsApp. Respondo rápido.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={reservaUrl} class="btn-primary">Reservar turno</a>
        <WhatsAppButton variant="secondary" label="Escribir por WhatsApp" />
      </div>
      <p class="mt-8 text-[11px] text-sam-light/40">
        Reservas procesadas por
        <a href="https://www.baqueanonatales.com" target="_blank" rel="noopener" class="text-sam-accent hover:underline">Baqueano Natales</a>
      </p>
    </div>
  </section>
</Layout>
