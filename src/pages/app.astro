---
export const prerender = true;

/**
 * Redirige /app a la descarga directa del APK client.
 *
 * La URL se resuelve por environment desde `astro:env/client`:
 *   - dev/staging: app-clientdev.apk
 *   - prod:        app-client.apk
 *
 * Antes estaba hardcodeada a `clientdev.apk`, lo que hacía que la web de
 * producción sirviera el binario de desarrollo. Corregido en este commit.
 */
import { PUBLIC_APK_URL } from 'astro:env/client';
const apkUrl = PUBLIC_APK_URL;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${apkUrl}`} />
  <title>Descargando Baqueano...</title>
  <script is:inline define:vars={{ apkUrl }}>
    window.location.replace(apkUrl);
  </script>
  <style>
    body { font-family: system-ui, sans-serif; text-align: center; padding: 40px; color: #1a1a1a; }
    a { color: #4ade80; }
    .hint { color: #666; font-size: 14px; margin-top: 20px; }
  </style>
</head>
<body>
  <h1>Descargando Baqueano...</h1>
  <p>Si la descarga no inicia automáticamente, <a href={apkUrl}>hacé clic acá</a>.</p>
  <p class="hint">Redirigiendo al APK...</p>
</body>
</html>
